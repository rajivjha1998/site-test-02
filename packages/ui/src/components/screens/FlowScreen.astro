---
import type { ScreenOf } from '../../schemas/screen';

type Props = ScreenOf<'flow'>;
const { stages } = Astro.props;
---

<ol class="flow" style={`--n: ${stages.length}`}>
  {stages.map((stage) => (
    <li class:list={['stage', { highlight: stage.highlight }]}>
      <p class="title">{stage.title}</p>
      <ul>
        {stage.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5) var(--space-4);
    list-style: none;
  }

  .stage {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: 12px;
    border: 1px solid var(--hair);
    border-radius: 10px;
    background: var(--surface);
  }

  /* Dashed connector between stages. */
  .stage:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: var(--space-5);
    border-top: 1.5px dashed color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .highlight {
    border-color: var(--accent-text);
    background: var(--accent-bg);
  }

  .title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }

  .highlight .title {
    color: var(--accent-text);
  }

  ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul li {
    font-size: 12px;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .stage:not(:last-child)::after {
      top: 100%;
      left: 50%;
      width: 0;
      height: var(--space-5);
      border-top: 0;
      border-left: 1.5px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    }
  }
</style>
