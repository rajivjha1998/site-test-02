---
// Asks for a work email before following any link to `href` (e.g. /enterprise/). Opens as a
// dialog on click, once per visitor; people who already left an email, people arriving from
// search and visitors without JavaScript go straight to the page.
import type { FormDefinition } from '../schemas/form';
import EmailCapture from '../forms/EmailCapture.astro';
import { withBase } from '../lib/href';

interface Props {
  href: string;
  form: FormDefinition;
  title: string;
  lede?: string;
  label: string;
  formsOrigin?: string;
  closeLabel?: string;
}

const { href, form, title, lede, label, formsOrigin, closeLabel = 'Close' } = Astro.props;
const id = `gate-${form.id}`;
---

<dialog class="gate" id={id} data-capture-gate={withBase(href)} aria-labelledby={`${id}-title`}>
  <button type="button" class="close" data-close aria-label={closeLabel}>
    ×
  </button>
  <p class="title" id={`${id}-title`}>
    {title}
  </p>
  {lede && <p class="lede">{lede}</p>}
  <EmailCapture uid={id} form={form} continueTo={href} label={label} formsOrigin={formsOrigin} />
</dialog>

<script>
  const known = () => {
    try {
      return localStorage.getItem('bbo-lead') === '1';
    } catch {
      return false;
    }
  };

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-capture-gate]')) {
    const target = dialog.dataset.captureGate!;
    if (typeof dialog.showModal !== 'function') continue;

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (!link || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (new URL(link.href, location.href).pathname !== target || known()) return;
      e.preventDefault();
      document
        .querySelectorAll<HTMLDetailsElement>('details[open]')
        .forEach((d) => (d.open = false));
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input[type="email"]')?.focus();
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Clicking the backdrop closes it, like Escape.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .gate {
    width: min(440px, calc(100vw - 2 * var(--gutter)));
    padding: var(--space-6);
    border: 0;
    border-radius: var(--r-card);
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow), var(--sh-win);
    color: var(--text);
  }

  .gate[open] {
    display: grid;
    gap: var(--space-3);
  }

  .gate::backdrop {
    background: rgb(15 23 42 / 0.35);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .title {
    padding-right: var(--space-6);
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.2;
    color: var(--ink);
  }

  .lede {
    font-size: 15px;
  }

  .close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: none;
    font-size: 22px;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
  }

  .close:hover {
    background: var(--subtle);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gate[open] {
      animation: gate-in 0.22s var(--ease-out);
    }

    @keyframes gate-in {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
      }
    }
  }
</style>
