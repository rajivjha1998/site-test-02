---
import type { FormDefinition } from '../schemas/form';
import { fieldMessages } from './validate';
import { HONEYPOT_FIELD, STAGE_FIELD, SUBMISSION_ID_FIELD } from './handle-submission';
import Button from '../primitives/Button.astro';
import { withBase } from '../lib/href';

interface Props {
  form: FormDefinition;
  /** Cloudflare Turnstile site key; omit to render without the widget (local development). */
  turnstileSiteKey?: string;
  /** Origin of the forms worker for static hosting; unset = same-site endpoint. */
  formsOrigin?: string;
  optionalLabel?: string;
  sendingLabel?: string;
}

const {
  form,
  turnstileSiteKey,
  formsOrigin,
  optionalLabel = '(optional)',
  sendingLabel = 'Sending…',
} = Astro.props;
const action = formsOrigin
  ? `${formsOrigin.replace(/\/$/, '')}${form.submit.endpoint}`
  : withBase(form.submit.endpoint);
const uid = `form-${form.id}`;
// Fields with a condition start hidden (no value can satisfy it before the visitor chooses).
const initiallyHidden = (f: FormDefinition['fields'][number]) => Boolean(f.showIf);

// Steps: each step is a fieldset. A single-step form is one group without a legend.
const byName = new Map(form.fields.map((f) => [f.name, f]));
const groups = form.steps
  ? form.steps.map((step) => ({ ...step, fields: step.fields.map((n) => byName.get(n)!) }))
  : [{ title: undefined, next: undefined, fields: form.fields }];
const stepped = groups.length > 1;
---

<div
  class="config-form"
  data-config-form
  data-form-id={form.id}
  data-stage-field={STAGE_FIELD}
  data-stepped={stepped ? 'true' : undefined}
  data-sending-label={sendingLabel}
  data-error-message={form.errorMessage}
>
  <form action={action} method="post" aria-describedby={`${uid}-status`}>
    {groups.map((group, stepIndex) => (
      <fieldset
        class:list={['step', { stepped }]}
        data-step={stepIndex}
        aria-labelledby={group.title ? `${uid}-step-${stepIndex}` : undefined}
      >
        {stepped && (
          <div class="step-head">
            <p class="progress" data-progress>
              {form.progressLabel
                .replace('{current}', String(stepIndex + 1))
                .replace('{total}', String(groups.length))}
            </p>
            <p class="step-title" id={`${uid}-step-${stepIndex}`}>
              {group.title}
            </p>
          </div>
        )}
        <div class="fields">
          {group.fields.map((field) => {
            const id = `${uid}-${field.name}`;
            const m = fieldMessages(field);
            const hidden = initiallyHidden(field);
            const describedBy = [field.hint && `${id}-hint`, `${id}-error`]
              .filter(Boolean)
              .join(' ');
            const common = {
              id,
              name: field.name,
              required: field.required,
              disabled: hidden,
              autocomplete: field.autocomplete,
              'aria-describedby': describedBy,
              'data-msg-required': m.required,
              'data-msg-email': m.email,
              'data-msg-url': m.url,
              'data-msg-number': m.number,
              'data-msg-min': m.min,
              'data-msg-max': m.max,
              'data-msg-too-long': m.tooLong,
              'data-prefill': field.prefillParam,
            };
            return (
              <div
                class:list={['field', field.width, field.type]}
                data-field={field.name}
                data-show-if={
                  field.showIf
                    ? JSON.stringify({
                        field: field.showIf.field,
                        equals: ([] as string[]).concat(field.showIf.equals),
                      })
                    : undefined
                }
                hidden={hidden}
              >
                {field.type === 'checkbox' ? (
                  <label class="check" for={id}>
                    <input type="checkbox" {...common} />
                    <span>{field.label}</span>
                  </label>
                ) : (
                  <label for={id}>
                    {field.label}
                    {!field.required && <span class="optional"> {optionalLabel}</span>}
                  </label>
                )}
                {field.hint && (
                  <p class="hint" id={`${id}-hint`}>
                    {field.hint}
                  </p>
                )}
                {field.type === 'select' && (
                  <select {...common}>
                    <option value="">{field.placeholder ?? ''}</option>
                    {field.options?.map((o) => (
                      <option value={o}>{o}</option>
                    ))}
                  </select>
                )}
                {field.type === 'textarea' && (
                  <textarea
                    rows="4"
                    maxlength={m.maxLength}
                    placeholder={field.placeholder}
                    {...common}
                  />
                )}
                {!['select', 'textarea', 'checkbox'].includes(field.type) && (
                  <input
                    type={field.type}
                    maxlength={field.type === 'number' ? undefined : m.maxLength}
                    min={field.min}
                    max={field.max}
                    inputmode={field.type === 'number' ? 'numeric' : undefined}
                    placeholder={field.placeholder}
                    {...common}
                  />
                )}
                <p class="error" id={`${id}-error`} data-error />
              </div>
            );
          })}
        </div>
        {stepped && stepIndex < groups.length - 1 && (
          <div class="step-nav">
            {stepIndex > 0 && (
              <Button type="button" variant="secondary" data-back="true">
                {form.backLabel}
              </Button>
            )}
            <Button type="button" data-next="true">
              {group.next}
            </Button>
          </div>
        )}
      </fieldset>
    ))}

    <input type="hidden" name={SUBMISSION_ID_FIELD} data-sid />

    <!-- Honeypot: invisible to people, tempting to bots. -->
    <div class="visually-hidden" aria-hidden="true">
      <label for={`${uid}-hp`}>Leave empty</label>
      <input id={`${uid}-hp`} name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
    </div>

    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />}

    <div class="actions" data-final>
      <div class="final-buttons">
        {stepped && (
          <Button type="button" variant="secondary" data-back="true">
            {form.backLabel}
          </Button>
        )}
        <Button type="submit">{form.submit.label}</Button>
      </div>
      {form.note && <p class="note">{form.note}</p>}
    </div>
    <p class="status" id={`${uid}-status`} role="status" data-status></p>
  </form>

  <div class="success" data-success hidden tabindex="-1">
    <p class="success-title">{form.success.title}</p>
    <p>{form.success.body}</p>
  </div>
</div>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
)}

<script>
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const messageFor = (control: Control): string => {
    const v = control.validity;
    const d = control.dataset;
    if (v.valueMissing) return d.msgRequired ?? '';
    if (v.typeMismatch) return (control.type === 'url' ? d.msgUrl : d.msgEmail) ?? '';
    if (v.badInput) return d.msgNumber ?? '';
    if (v.rangeUnderflow) return d.msgMin ?? '';
    if (v.rangeOverflow) return d.msgMax ?? '';
    if (v.tooLong) return d.msgTooLong ?? '';
    return control.validationMessage;
  };

  // Session storage can be unavailable (private mode, blocked storage): never let it break the form.
  const store = {
    get: (key: string) => {
      try {
        return JSON.parse(sessionStorage.getItem(key) ?? 'null');
      } catch {
        return null;
      }
    },
    set: (key: string, value: unknown) => {
      try {
        sessionStorage.setItem(key, JSON.stringify(value));
      } catch {
        /* storage unavailable */
      }
    },
    clear: (key: string) => {
      try {
        sessionStorage.removeItem(key);
      } catch {
        /* storage unavailable */
      }
    },
  };

  /** Mark this visitor as a known lead, so email gates don't ask again. */
  const rememberLead = () => {
    try {
      localStorage.setItem('bbo-lead', '1');
    } catch {
      /* storage unavailable */
    }
  };

  const newId = () =>
    crypto.randomUUID?.() ??
    `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-config-form]')) {
    const form = root.querySelector('form')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const sidInput = form.querySelector<HTMLInputElement>('[data-sid]')!;
    const stepped = root.dataset.stepped === 'true';
    const storeKey = `bbo-form-${root.dataset.formId}`;
    const controlsIn = (scope: ParentNode) => [
      ...scope.querySelectorAll<Control>(
        '[data-field] input, [data-field] select, [data-field] textarea',
      ),
    ];
    const controls = () => controlsIn(form);
    form.noValidate = true;

    const showError = (control: Control, message: string) => {
      const error = form.querySelector<HTMLElement>(`#${control.id}-error`);
      if (error) error.textContent = message;
      control.toggleAttribute('aria-invalid', Boolean(message));
    };

    /** Validates the enabled controls in a scope; shows errors and focuses the first one. */
    const validate = (scope: ParentNode) => {
      const list = controlsIn(scope).filter((c) => !c.disabled);
      list.forEach((c) => showError(c, c.checkValidity() ? '' : messageFor(c)));
      const invalid = list.find((c) => !c.checkValidity());
      invalid?.focus();
      return !invalid;
    };

    // Conditional fields: shown, enabled and validated only when their condition holds.
    const applyConditions = () => {
      const data = new FormData(form);
      for (const wrapper of form.querySelectorAll<HTMLElement>('[data-show-if]')) {
        const rule = JSON.parse(wrapper.dataset.showIf!) as { field: string; equals: string[] };
        const on = rule.equals.includes(String(data.get(rule.field) ?? ''));
        wrapper.hidden = !on;
        wrapper
          .querySelectorAll<Control>('input, select, textarea')
          .forEach((c) => (c.disabled = !on));
      }
    };

    // Steps: one fieldset at a time once JavaScript runs; all of them without it.
    let current = 0;
    const show = (index: number, focus = true) => {
      current = index;
      steps.forEach((step, i) => (step.hidden = i !== index));
      root.querySelector<HTMLElement>('[data-final]')!.hidden = index !== steps.length - 1;
      if (focus)
        controlsIn(steps[index]!)
          .find((c) => !c.disabled)
          ?.focus();
    };

    // The submission id links a step-1 save to the complete submission.
    const saved = store.get(storeKey) as { sid: string; values: Record<string, string> } | null;
    const params = new URLSearchParams(location.search);
    sidInput.value = params.get('sid') ?? saved?.sid ?? newId();

    // Pre-fill: query string first (e.g. /demo/?industry=… or ?email=… from an email capture),
    // then anything this visitor already typed in this session.
    for (const control of controls()) {
      const key = control.dataset.prefill;
      const value = (key && params.get(key)) ?? saved?.values?.[control.name] ?? null;
      if (value === null) continue;
      if (
        control instanceof HTMLSelectElement &&
        ![...control.options].some((o) => o.value === value)
      )
        continue;
      control.value = value;
    }
    if (params.get('form') === 'error') status.textContent = root.dataset.errorMessage ?? '';
    applyConditions();

    /** Saves step 1 as a partial lead. Never blocks the visitor if the network fails. */
    const savePartial = () => {
      const data = new FormData();
      for (const c of controlsIn(steps[0]!)) if (!c.disabled) data.append(c.name, c.value);
      const honeypot = form.querySelector<HTMLInputElement>('[tabindex="-1"]');
      if (honeypot?.value) data.append(honeypot.name, honeypot.value);
      data.append(root.dataset.stageField ?? '_stage', 'partial');
      data.append(sidInput.name, sidInput.value);
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
        keepalive: true,
      }).catch(() => undefined);
    };

    const remember = () => {
      const values: Record<string, string> = {};
      for (const c of controls()) if (c.value) values[c.name] = c.value;
      store.set(storeKey, { sid: sidInput.value, values });
    };

    if (stepped) {
      root.dataset.enhanced = 'true';
      // Arriving with step 1 already captured (email capture, enterprise gate or a reload)
      // starts on step 2.
      const firstDone =
        (params.has('sid') || saved) && controlsIn(steps[0]!).every((c) => c.checkValidity());
      show(firstDone ? 1 : 0, false);

      form.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('button');
        if (!target) return;
        if (target.hasAttribute('data-next')) {
          if (!validate(steps[current]!)) return;
          if (current === 0) {
            savePartial();
            rememberLead();
          }
          remember();
          show(current + 1);
        } else if (target.hasAttribute('data-back')) {
          show(Math.max(0, current - 1));
        }
      });
    }

    form.addEventListener('change', () => {
      applyConditions();
      if (stepped) remember();
    });
    form.addEventListener('focusout', (e) => {
      const control = e.target as Control;
      if (control.matches?.('[data-field] *') && control.value)
        showError(control, control.checkValidity() ? '' : messageFor(control));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      // Validate every step; jump back to the first step with a problem.
      for (const [i, step] of steps.entries()) {
        const bad = controlsIn(step).some((c) => !c.disabled && !c.checkValidity());
        if (bad) {
          if (stepped) show(i, false);
          validate(step);
          return;
        }
      }

      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = root.dataset.sendingLabel ?? label;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as { ok: boolean; errors?: Record<string, string> };
        if (result.ok) {
          store.clear(storeKey);
          rememberLead();
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        const { _form: formError, ...fieldErrors } = result.errors ?? {};
        for (const [name, message] of Object.entries(fieldErrors)) {
          const control = form.querySelector<Control>(`[name="${CSS.escape(name)}"]`);
          if (!control) continue;
          showError(control, message);
          const owner = steps.findIndex((s) => s.contains(control));
          if (stepped && owner >= 0) show(owner, false);
        }
        status.textContent = formError ?? '';
        form.querySelector<Control>('[aria-invalid]')?.focus();
      } catch {
        status.textContent = root.dataset.errorMessage ?? '';
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>

<style>
  .step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .step + .step {
    margin-top: var(--space-6);
  }

  /* Once JavaScript runs, one step shows at a time. */
  [data-enhanced] .step + .step {
    margin-top: 0;
  }

  .step-head {
    display: grid;
    gap: 4px;
    margin-bottom: var(--space-4);
  }

  .progress {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--ink);
  }

  /* Step buttons only work with JavaScript; without it the form is one page. */
  .step-nav {
    display: none;
  }

  [data-enhanced] .step-nav {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .final-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .final-buttons :global([data-back]) {
    display: none;
  }

  [data-enhanced] .final-buttons :global([data-back]) {
    display: inline-flex;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .field {
    display: grid;
    align-content: start;
    gap: 6px;
    grid-column: 1 / -1;
  }

  .field.half {
    grid-column: span 1;
  }

  .field[hidden] {
    display: none;
  }

  label {
    font-size: var(--fs-small);
    color: var(--ink);
  }

  .optional {
    color: var(--muted);
  }

  .hint {
    font-size: 13px;
    color: var(--muted);
  }

  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--r-btn);
    background: var(--surface);
    font-size: 15px;
    color: var(--ink);
  }

  input:not([type='checkbox']),
  select {
    height: 46px;
  }

  textarea {
    resize: vertical;
  }

  /* Same specificity as the base control rule above, declared later, so it wins. */
  input[aria-invalid],
  select[aria-invalid],
  textarea[aria-invalid] {
    border-color: var(--error);
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .check input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--accent);
  }

  .error {
    min-height: 0;
    font-size: 13px;
    color: var(--error-text);
  }

  .error:empty {
    display: none;
  }

  .actions {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .actions[hidden] {
    display: none;
  }

  .note {
    font-size: 13px;
    color: var(--muted);
  }

  .status:not(:empty) {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-btn);
    background: color-mix(in srgb, var(--error) 10%, var(--surface));
    font-size: var(--fs-small);
    color: var(--error-text);
  }

  .cf-turnstile {
    margin-top: var(--space-4);
  }

  .success {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--r-card);
    background: var(--accent-bg);
  }

  .success[hidden] {
    display: none;
  }

  .success-title {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    [data-enhanced] .step-nav,
    .final-buttons {
      flex-direction: column-reverse;
    }

    .step-nav :global(.btn),
    .final-buttons :global(.btn) {
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .field.half {
      grid-column: 1 / -1;
    }

    .actions {
      justify-items: stretch;
    }
  }
</style>
