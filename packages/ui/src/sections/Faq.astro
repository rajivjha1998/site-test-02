---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

type Props = Omit<SectionOf<'faq'>, 'type'> & { uid: string };
const {
  uid,
  icon,
  anchor = 'faq',
  title,
  titleAccent,
  lede,
  band = 'surface',
  items,
} = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor} width="narrow">
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <div class="list">
    {items.map((item, i) => (
      <details open={i === 0}>
        <summary>
          <h3>{item.q}</h3>
          <span class="toggle" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</SectionShell>

<style>
  .list {
    margin-top: var(--space-7);
    padding: var(--space-1) var(--space-6);
    border-radius: var(--r-card);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  details + details {
    border-top: 1px solid var(--hair);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    font-size: 19px;
    line-height: 1.35;
  }

  .toggle {
    position: relative;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent-bg);
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1.6px;
    background: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }

  .toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  p {
    max-width: 65ch;
    padding-bottom: var(--space-5);
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .list {
      padding: var(--space-1) var(--space-4);
    }

    h3 {
      font-size: 17px;
    }
  }
</style>
