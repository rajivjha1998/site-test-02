---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import Ctas from '../primitives/Ctas.astro';
import EmailCapture from '../forms/EmailCapture.astro';
import type { FormDefinition } from '../schemas/form';

type Props = Omit<SectionOf<'ctaPanel'>, 'type'> & {
  uid: string;
  captureForm?: FormDefinition;
  formsOrigin?: string;
};
const {
  uid,
  anchor,
  title,
  titleAccent,
  lede,
  band,
  icon,
  capture,
  captureForm,
  formsOrigin,
  ctas,
  note,
} = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <!-- The one framed panel per page (claude-design.md §4). -->
  <div class="panel">
    <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
    {capture && captureForm && (
      <EmailCapture
        uid={uid}
        form={captureForm}
        continueTo={capture.continueTo}
        label={capture.label}
        placeholder={capture.placeholder}
        note={capture.note}
        formsOrigin={formsOrigin}
        align="center"
      />
    )}
    <Ctas ctas={ctas} align="center" />
    {note && <p class="note">{note}</p>}
  </div>
</SectionShell>

<style>
  .panel {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: clamp(44px, 7vw, 72px) var(--space-6);
    border-radius: var(--r-panel);
    background:
      radial-gradient(60% 90% at 12% 0%, var(--glow-2), transparent 70%),
      radial-gradient(60% 90% at 88% 100%, var(--glow-1), transparent 70%), var(--glass-bg);
    text-align: center;
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .note {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .panel {
      justify-items: stretch;
      padding-inline: var(--space-5);
    }
  }
</style>
