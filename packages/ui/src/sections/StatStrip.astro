---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

type Props = Omit<SectionOf<'statStrip'>, 'type'> & { uid: string };
const {
  uid,
  icon,
  anchor,
  title,
  titleAccent,
  lede,
  band = 'surface',
  items,
  source,
} = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  {title ? (
    <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  ) : (
    <h2 id={id} class="visually-hidden">
      {items.map((i) => i.label).join(', ')}
    </h2>
  )}
  <dl class:list={['stats', { titled: title }]} style={`--n: ${items.length}`}>
    {items.map((item) => (
      <div class="stat">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
  {source && <p class="source">{source}</p>}
</SectionShell>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    border-radius: var(--r-win);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .titled {
    margin-top: var(--space-7);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .stat + .stat {
    border-inline-start: 1px solid var(--hair);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  dt {
    font-size: var(--fs-small);
    color: var(--text);
  }

  .source {
    margin-top: var(--space-4);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat + .stat {
      border-inline-start: 0;
    }

    .stat:nth-child(even) {
      border-inline-start: 1px solid var(--hair);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--hair);
    }
  }
</style>
