---
import type { SectionOf } from '../schemas/sections';
import Picture from '../primitives/Picture.astro';
import type { WithResolvedImage } from '../lib/image';

type Props = Omit<WithResolvedImage<SectionOf<'testimonial'>, 'avatar'>, 'type'> & {
  uid: string;
};
const { uid, band = 'accent', quote, name, role, avatar } = Astro.props;
const id = `${uid}-quote`;
---

<section class:list={['band', `band-${band}`]} aria-labelledby={id}>
  <figure>
    <span class="mark" aria-hidden="true">
      “
    </span>
    <blockquote id={id}>
      <p>{quote}</p>
    </blockquote>
    <figcaption>
      {avatar && (
        <span class="avatar">
          <Picture image={avatar} ratio="1 / 1" radius="full" />
        </span>
      )}
      <span class="who">
        <span class="name">{name}</span>
        <span class="role">{role}</span>
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .band {
    padding: var(--space-8) var(--gutter);
  }

  .band-accent {
    background: color-mix(in srgb, var(--accent-bg) 60%, transparent);
  }

  .band-surface {
    background: var(--band-tint);
  }

  figure {
    display: grid;
    gap: var(--space-4);
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-7);
    border-radius: 22px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .mark {
    height: 32px;
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--accent);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(21px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-small);
  }

  .avatar {
    flex: none;
    width: 48px;
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .name {
    color: var(--ink);
  }

  .role {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    figure {
      padding: var(--space-5);
    }
  }
</style>
