---
import type { SectionOf } from '../schemas/sections';
import type { PageCard } from '../schemas/page';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import Icon from '../primitives/Icon.astro';
import IconTile from '../primitives/IconTile.astro';
import { withBase } from '../lib/href';

type Props = Omit<SectionOf<'pageCards'>, 'type'> & {
  uid: string;
  /** Every page card on the site; filtered here by group / tag. */
  cards: PageCard[];
  currentPath: string;
};

const {
  uid,
  icon,
  anchor,
  title,
  titleAccent,
  lede,
  band,
  group,
  tag,
  groupByTags,
  excludeCurrent,
  columns,
  linkLabel,
  cards,
  currentPath,
} = Astro.props;
const id = `${uid}-title`;

const matching = cards
  .filter((c) => c.group === group && (!tag || c.tags.includes(tag)))
  .filter((c) => !excludeCurrent || c.path !== currentPath)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const buckets = groupByTags
  ? groupByTags.map((g) => ({
      heading: g.heading,
      cards: matching.filter((c) => c.tags.includes(g.tag)),
    }))
  : [{ heading: undefined, cards: matching }];

// Card titles sit one level below whatever heading precedes them, so the outline never skips.
const CardHeading = groupByTags ? 'h4' : 'h3';

if (matching.length === 0) {
  throw new Error(
    `pageCards: no pages with card.group "${group}"${tag ? ` and tag "${tag}"` : ''}`,
  );
}
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  {buckets
    .filter((b) => b.cards.length > 0)
    .map((bucket) => (
      <div class="bucket">
        {bucket.heading && <h3 class="bucket-title">{bucket.heading}</h3>}
        <ul class="cards" style={`--cols: ${columns}`}>
          {bucket.cards.map((card) => (
            <li class="card">
              {card.icon && <IconTile name={card.icon} />}
              <CardHeading class="card-title">
                <a href={withBase(card.path)}>{card.title}</a>
              </CardHeading>
              <p>{card.summary}</p>
              <span class="more" aria-hidden="true">
                {linkLabel}
                <Icon name="arrow-right" size={16} class="arrow" />
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
</SectionShell>

<style>
  .bucket {
    margin-top: var(--space-8);
  }

  .bucket + .bucket {
    margin-top: var(--space-7);
  }

  .bucket-title {
    margin-bottom: var(--space-4);
    font-size: 22px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The whole card is clickable via the heading link's stretched hit area. */
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--r-card);
    transition: border-color var(--dur-fast) ease;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--hair));
  }

  .card:focus-within {
    box-shadow: var(--focus-ring);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:focus-visible {
    box-shadow: none;
  }

  p {
    font-size: 15px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--accent);
  }

  .more :global(.arrow) {
    transition: transform var(--dur-fast) ease;
  }

  .card:hover .more :global(.arrow) {
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
