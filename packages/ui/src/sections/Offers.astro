---
import type { SectionOf } from '../schemas/sections';
import type { WithResolvedImage } from '../lib/image';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import Picture from '../primitives/Picture.astro';
import Button from '../primitives/Button.astro';

type Item = SectionOf<'offers'>['items'][number];
type Props = Omit<SectionOf<'offers'>, 'type' | 'items'> & {
  uid: string;
  items: WithResolvedImage<Item>[];
};
const { uid, icon, anchor, title, titleAccent, lede, band, columns, items } = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <ul class="grid" style={`--cols: ${columns}`}>
    {items.map((item) => (
      <li class="card">
        {item.image && <Picture image={item.image} ratio="16 / 10" radius="none" />}
        <div class="body">
          {item.badge && <span class="badge">{item.badge}</span>}
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.price && (
            <p class="price">
              <span class="amount">{item.price}</span>
              {item.priceNote && <span class="note">{item.priceNote}</span>}
            </p>
          )}
          {item.cta && (
            <div class="cta">
              <Button href={item.cta.href} variant={item.cta.variant}>
                {item.cta.label}
              </Button>
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
</SectionShell>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .badge {
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--accent-bg);
    font-size: var(--fs-label);
    color: var(--accent-text);
  }

  h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  p {
    font-size: 15px;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .amount {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
  }

  .note {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .cta {
    margin-top: var(--space-2);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
