---
import type { SectionOf } from '../schemas/sections';
import type { WithResolvedImage } from '../lib/image';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import Picture from '../primitives/Picture.astro';

type Member = SectionOf<'team'>['members'][number];
type Props = Omit<SectionOf<'team'>, 'type' | 'members'> & {
  uid: string;
  members: WithResolvedImage<Member, 'photo'>[];
};
const { uid, icon, anchor, title, titleAccent, lede, band, members } = Astro.props;
const id = `${uid}-title`;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]!.toUpperCase())
    .join('');
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <ul class="grid">
    {members.map((member) => (
      <li class="member">
        <div class="avatar">
          {member.photo ? (
            <Picture image={member.photo} ratio="1 / 1" radius="full" />
          ) : (
            <span class="initials" aria-hidden="true">
              {initials(member.name)}
            </span>
          )}
        </div>
        <h3>{member.name}</h3>
        <p class="role">{member.role}</p>
        {member.bio && <p class="bio">{member.bio}</p>}
      </li>
    ))}
  </ul>
</SectionShell>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-2);
    text-align: center;
  }

  .avatar {
    width: 112px;
    margin-bottom: var(--space-2);
  }

  .initials {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-pill);
    background: var(--accent-bg);
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--accent-text);
  }

  h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .role {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .bio {
    max-width: 30ch;
    font-size: 15px;
  }
</style>
