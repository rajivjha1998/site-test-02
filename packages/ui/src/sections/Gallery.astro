---
import type { SectionOf } from '../schemas/sections';
import type { ResolvedImage } from '../lib/image';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import Picture from '../primitives/Picture.astro';

type Props = Omit<SectionOf<'gallery'>, 'type' | 'images'> & {
  uid: string;
  images: (ResolvedImage & { caption?: string })[];
};
const { uid, icon, anchor, title, titleAccent, lede, band, columns, images } = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <ul class="grid" style={`--cols: ${columns}`}>
    {images.map((image) => (
      <li>
        <figure>
          <Picture image={image} ratio="4 / 3" />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</SectionShell>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  figure {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  figcaption {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
