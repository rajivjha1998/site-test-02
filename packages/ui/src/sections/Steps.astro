---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import IconTile from '../primitives/IconTile.astro';
import Ctas from '../primitives/Ctas.astro';

type Props = Omit<SectionOf<'steps'>, 'type'> & { uid: string };
const { uid, icon, anchor, title, titleAccent, lede, band, steps, ctas } = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <ol class="steps" style={`--n: ${steps.length}`}>
    {steps.map((step, i) => (
      <li>
        <div class="top">
          {step.icon && <IconTile name={step.icon} size="sm" />}
          <span class="num" aria-hidden="true">
            {i + 1}
          </span>
        </div>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </li>
    ))}
  </ol>
  {ctas.length > 0 && (
    <div class="ctas">
      <Ctas ctas={ctas} align="center" />
    </div>
  )}
</SectionShell>

<style>
  /* Numbered because the content is a real sequence (frontend-design checklist). */
  .steps {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--r-card);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-bg);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-text);
  }

  h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  p {
    font-size: 15px;
  }

  .ctas {
    margin-top: var(--space-7);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
