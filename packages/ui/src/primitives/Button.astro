---
import type { Cta } from '../schemas/common';
import Icon from './Icon.astro';
import { withBase } from '../lib/href';

interface Props {
  href?: string;
  variant?: Cta['variant'];
  size?: 'md' | 'sm';
  /** Renders a <button> instead of a link. */
  type?: 'button' | 'submit';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { href, variant = 'primary', size = 'md', type, class: className, ...rest } = Astro.props;
const external = href?.startsWith('http');
---

{type || !href ? (
  <button type={type ?? 'button'} class:list={['btn', variant, size, className]} {...rest}>
    <slot />
  </button>
) : (
  <a
    href={withBase(href)}
    class:list={['btn', variant, size, className]}
    rel={external ? 'noopener' : undefined}
    {...rest}
  >
    <slot />
    {variant === 'link' && <Icon name="chevron-right" size={16} class="chev" />}
  </a>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--r-btn);
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .md {
    padding: 13px 22px;
  }

  .sm {
    padding: 9px 14px;
    font-size: var(--fs-small);
  }

  .primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 6px 16px -8px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .primary:hover {
    background: var(--accent-strong);
  }

  /* Frosted secondary action — matches the glass surfaces around it. */
  .secondary {
    background: var(--glass-bg-strong);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    color: var(--ink);
  }

  .secondary:hover {
    background: var(--surface);
  }

  .link {
    gap: 2px;
    padding-inline: 0;
    background: none;
    color: var(--accent);
    font-weight: 500;
  }

  .link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .link :global(.chev) {
    transition: transform var(--dur-fast) ease;
  }

  .link:hover :global(.chev) {
    transform: translateX(2px);
  }
</style>
